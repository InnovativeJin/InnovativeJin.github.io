@misc{kim2026textreid,
  abbr         = {Research},
  title        = {Robust Text-to-Image Person Re-Identification for Real-World Search},
  author       = {Kim, Hyukjin},
  howpublished = {Student Researcher · Visual Intelligence Group, KIST},
  year         = {2026},
  note         = {Ongoing (Aug. 2026 – present)},
  abstract     = {• Text-based person retrieval for missing-person and suspect searches where reference images are unavailable and only natural-language descriptions may be provided<br>• Adding image-grounded attributes generated by a vision-language model produced only modest gains, which led to asking which textual details the model actually uses<br>• Controlled attribute-ablation experiments on IRRA across CUHK-PEDES, RSTPReID, and ICFG-PEDES: removing upper-body clothing descriptions reduced Rank-1 by 31.6, 25.6, and 43.3 percentage points; the relative importance of garment color and type differed across datasets},
  selected     = {true}
}

