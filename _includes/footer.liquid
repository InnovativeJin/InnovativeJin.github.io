{% comment %}
  Gallery footer override: a parchment band on every page with the contact
  links and a 12px legal row. On the home page it sits flush under the last tile.
{% endcomment %}
<footer class="g-footer{% if page.layout == 'about' %} g-footer--flush{% endif %}" role="contentinfo">
  <div class="g-footer__inner">
    <ul class="g-footer__links">
      {% if site.data.socials.email %}
        <li><a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a></li>
      {% endif %}
      {% if site.data.socials.scholar_userid %}
        <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a></li>
      {% endif %}
      {% if site.data.socials.github_username %}
        <li><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a></li>
      {% endif %}
      {% if site.data.socials.linkedin_username %}
        <li><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a></li>
      {% endif %}
      <li><a href="{{ '/cv/' | relative_url }}">CV</a></li>
    </ul>
    <div class="g-footer__legal">
      <span>
        &copy; {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.last_name }}
        {%- if site.last_updated %} · Last updated {{ site.time | date: '%b %Y' }}{% endif -%}
      </span>
      <span>{{ site.footer_text }}</span>
    </div>
  </div>
</footer>

{% comment %} "Show details" toggle for bibliography abstracts (projects page). {% endcomment %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("a.abstract.btn").forEach(function (btn) {
      var entry = btn.closest("li") || btn.parentElement;
      var content = entry.querySelector("div.abstract");
      if (!content) return;
      var closed = "Show details";
      var open = "Hide details";
      // Control visibility with an inline style (reliable against Tailwind's
      // layered .hidden utility); drop the class so it can't interfere.
      content.classList.remove("hidden");
      content.style.display = "none";
      btn.textContent = closed;
      btn.setAttribute("href", "javascript:void(0)");
      btn.setAttribute("role", "button");
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        var isHidden = content.style.display === "none";
        content.style.display = isHidden ? "block" : "none";
        btn.textContent = isHidden ? open : closed;
      });
    });
  });
</script>
